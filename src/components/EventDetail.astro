---
// Event detail layout, shared by the real event pages and the CMS live
// preview. Every editable element carries a data-cms-* binding (see
// src/scripts/cms-preview.ts). Optional rows are always rendered and
// hidden when empty so the preview can reveal them as editors type.
import Icon from './Icon.astro';
import Photos from './Photos.astro';
import ShareTools from './ShareTools.astro';
import { accommodations } from '../data/taxonomy';
import { dateLabel, timeRange, googleCalendarUrl, lastDay } from '../lib/events';
import { mdEntry } from '../lib/markdown';

interface Props {
  data: Record<string, any>;
  id?: string;
  body?: string;
}

const { data: d, id = '', body = '' } = Astro.props;
const accs: string[] = d.accommodations ?? [];
const pageUrl = new URL(`/events/${id}/`, Astro.site).toString();
const time = timeRange(d as any);
const gcal = d.date ? googleCalendarUrl(d as any, pageUrl) : '';
const hints = Object.fromEntries(accommodations.map((a) => [a.id, a.hint])) as Record<string, string>;
const place = [d.location, d.city].filter(Boolean).join(', ');
const mapUrl = place ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place)}` : '';
const bodyHtml = mdEntry(body.trim());
---

<section class="page-hero">
  <div class="container">
    <a class="back" href="/events/"><Icon name="back" size={18} /> All events</a>
    <span class="eyebrow" data-cms-compute="event-eyebrow" hidden={!(d.recurring && !d.date)}>Recurring program</span>
    <h1 data-cms="entry:title">{d.title}</h1>
    <p class="host" data-cms-show="entry:host" hidden={!d.host}>Hosted by <span data-cms="entry:host">{d.host}</span></p>
    <p class="past-note" hidden data-last-day={lastDay(d as any) || undefined}>This event has already happened.</p>
  </div>
</section>

<section class="section-tight">
  <div class="container detail">
    <div class="main">
      <p class="summary" data-cms="entry:summary">{d.summary}</p>

      <Photos photos={d.photos} />

      <div class="prose" data-cms-md-entry="entry:body" data-cms-show="entry:body" hidden={!bodyHtml} set:html={bodyHtml} />

      <div data-cms-show="entry:accommodations" hidden={accs.length === 0}>
        <h2>Accommodations</h2>
        <ul class="acc-list" data-cms-list="entry:accommodations">
          <template data-cms-item-template>
            <li data-cms-item>
              <span class="check"><Icon name="check" size={18} /></span>
              <div>
                <strong data-cms-field="."></strong>
                <span data-cms-field-compute="acc-hint"></span>
              </div>
            </li>
          </template>
          {
            accs.map((a) => (
              <li data-cms-item>
                <span class="check">
                  <Icon name="check" size={18} />
                </span>
                <div>
                  <strong data-cms-field=".">{a}</strong>
                  <span data-cms-field-compute="acc-hint" hidden={!hints[a]}>{hints[a]}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="notice">
        <Icon name="info" size={22} />
        <p>
          Event details come from the host and can change. Please confirm with them before you go. Spot a problem?
          <a href={`/contact/?about=${encodeURIComponent(d.title ?? '')}`}>Let us know</a>.
        </p>
      </div>
    </div>

    <aside class="side card">
      <dl>
        <div>
          <dt><Icon name={d.date ? 'calendar' : 'repeat'} size={18} data-cms-compute="event-when-icon" /> When</dt>
          <dd data-cms-compute="event-when">
            {dateLabel(d as any, true)}
            {time && <><br />{time}</>}
          </dd>
        </div>
        <div data-cms-compute="event-where-row" hidden={!place}>
          <dt>
            <Icon name="pin" size={18} /> Where
          </dt>
          <dd>
            <span data-cms-compute="event-where">{place}</span>
            <span data-cms-compute="event-maps" hidden={!(d.location && mapUrl)}>
              <br />
              <a href={mapUrl} target="_blank" rel="noopener">Open in Maps</a>
            </span>
          </dd>
        </div>
        <div data-cms-show="entry:cost" hidden={!d.cost}>
          <dt>
            <Icon name="dollar" size={18} /> Cost
          </dt>
          <dd data-cms="entry:cost">{d.cost}</dd>
        </div>
        <div data-cms-show="entry:ages" hidden={!d.ages}>
          <dt>
            <Icon name="child" size={18} /> Ages
          </dt>
          <dd data-cms="entry:ages">{d.ages}</dd>
        </div>
        <div data-cms-show="entry:registration" hidden={!d.registration}>
          <dt>
            <Icon name="ticket" size={18} /> Registration
          </dt>
          <dd data-cms="entry:registration">{d.registration}</dd>
        </div>
      </dl>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={d.url}
          target="_blank"
          rel="noopener"
          data-cms-show="entry:url"
          data-cms-attr="href|entry:url"
          hidden={!d.url}
        >
          Event details <Icon name="external" size={18} />
        </a>
        <span class="actions" data-cms-compute="event-has-date" hidden={!d.date}>
          <a class="btn btn-secondary" href={gcal} target="_blank" rel="noopener">
            <Icon name="calendar" size={18} /> Add to Google Calendar
          </a>
          <a class="btn btn-secondary" href={`/events/${id}.ics`} download>
            <Icon name="calendar" size={18} /> Download .ics
          </a>
        </span>
        <ShareTools title={d.title ?? 'Event'} />
        {d.url && <p class="print-only">More info: {d.url}</p>}
      </div>
    </aside>
  </div>
</section>

<script>
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
  const note = document.querySelector<HTMLElement>('.past-note[data-last-day]');
  if (note && (note.dataset.lastDay ?? '') < today) note.hidden = false;
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .page-hero .eyebrow {
    display: block;
  }
  h1 {
    color: var(--brand-primary);
  }
  .host {
    font-weight: 700;
    color: var(--brand-primary) !important;
  }
  .past-note:not([hidden]) {
    display: inline-block;
    margin-top: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface-alt);
    color: var(--ink) !important;
    font-size: 0.95rem !important;
  }
  .detail {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .detail {
      grid-template-columns: 1fr 340px;
      gap: 48px;
    }
    .side {
      position: sticky;
      top: 96px;
    }
  }
  .summary {
    font-size: 1.2rem;
  }
  .main h2 {
    font-size: 1.35rem;
    color: var(--brand-primary);
    margin-top: 1.4em;
  }
  .acc-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .acc-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .acc-list li {
    display: flex;
    gap: 12px;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .acc-list strong {
    display: block;
  }
  .acc-list span:not(.check) {
    font-size: 0.92rem;
    color: var(--ink-muted);
  }
  .check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
  }
  .notice {
    margin-top: 24px;
  }
  .side {
    padding: 24px;
  }
  dl {
    margin: 0 0 20px;
    display: grid;
    gap: 16px;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--brand-primary);
  }
  dt :global(svg) {
    color: var(--brand-green);
  }
  dd {
    margin: 4px 0 0 26px;
  }
  .actions {
    display: grid;
    gap: 10px;
  }
</style>
