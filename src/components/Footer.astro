---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
import { getCopy, mdi } from '../lib/copy';

const t = await getCopy('site');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo variant="horizontal" height={64} />
        <p data-cms="site:footer_blurb">{t.footer_blurb}</p>

        <form
          class="newsletter"
          name="newsletter"
          method="POST"
          action="/subscribed/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          aria-labelledby="newsletter-title"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <input type="hidden" name="subject" value="New newsletter signup — Limitless PA" />
          <p class="honeypot"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <h2 id="newsletter-title" data-cms="site:newsletter_title">{t.newsletter_title}</h2>
          <p class="nl-text" data-cms="site:newsletter_text">{t.newsletter_text}</p>
          <div class="nl-row">
            <label for="newsletter-email" class="visually-hidden">Email address</label>
            <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="Email address" required />
            <button class="btn btn-secondary" type="submit" data-cms="site:newsletter_button">{t.newsletter_button}</button>
          </div>
        </form>
      </div>

      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul>
          {nav.filter((item) => item.href !== '/donate/').map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2>Get involved</h2>
        <ul>
          <li><a href="/suggest/">Suggest a place</a></li>
          <li><a href="/submit-event/">Share an event</a></li>
          <li><a href="/for-businesses/">Get your business listed</a></li>
          <li><a href="/donate/">Donate</a></li>
          <li><a href="/contact/">Contact us</a></li>
        </ul>
      </div>
    </div>

    <div class="disclaimer">
      <Icon name="info" size={22} />
      <p data-cms-mdi="site:disclaimer" set:html={mdi(t.disclaimer)} />
    </div>

    <div class="bottom">
      <p>&copy; {year} {site.name}. {site.tagline}</p>
      <p class="bottom-links">
        <a href="/privacy/">Privacy</a>
        <span class="credit">
          Website donated by
          <a class="cb" href="https://clientbridgeusa.com" target="_blank" rel="noopener">
            <img class="cb-mark" src="/partners/clientbridgeusa/mark.svg" alt="" width="48" height="20" />
            <img class="cb-wordmark" src="/partners/clientbridgeusa/wordmark.svg" alt="ClientBridgeUSA" width="104" height="13" />
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-alt);
    border-top: 1px solid var(--line);
    color: var(--ink);
    padding-block: 56px 28px;
  }
  .site-footer a {
    color: var(--brand-primary);
  }
  .top {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 800px) {
    .top {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
  .about :global(img) {
    height: 64px;
    width: auto;
    max-width: 100%;
    margin-bottom: 16px;
  }
  .about p {
    max-width: 40ch;
    color: var(--ink-muted);
  }
  .newsletter {
    margin-top: 28px;
    max-width: 420px;
  }
  .newsletter h2 {
    margin-bottom: 4px;
  }
  .newsletter .nl-text {
    margin: 0 0 12px;
    font-size: 0.95rem;
  }
  .nl-row {
    display: flex;
    gap: 8px;
  }
  .nl-row input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 10px 14px;
    font: inherit;
    font-size: 0.97rem;
    color: var(--ink);
    background: #fff;
    border: 1.5px solid var(--gray-400);
    border-radius: 999px;
  }
  .nl-row input:focus {
    border-color: var(--brand-primary);
    outline: 2px solid var(--brand-primary);
    outline-offset: 0;
  }
  .nl-row .btn {
    min-height: 44px;
    padding-block: 0.5em;
  }
  h2 {
    font-size: 1rem;
    color: var(--brand-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  ul a {
    text-decoration: none;
  }
  ul a:hover {
    text-decoration: underline;
  }
  .disclaimer {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 40px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .disclaimer :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--brand-primary);
  }
  .disclaimer p {
    margin: 0;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .bottom p {
    margin: 0;
  }
  .bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  /* ClientBridgeUSA logo: their files, unaltered, sized in the same
     proportions their own site uses (mark 28px : text 1.2rem). */
  .cb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .cb-mark {
    height: 20px;
    width: auto;
  }
  .cb-wordmark {
    height: 13px;
    width: auto;
  }
</style>
