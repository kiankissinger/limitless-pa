---
// Official Limitless PA logo lockups, taken unaltered from the brand sheet
// (design/Branding-limitlesspa.svg). Do not recolor, crop, or restyle —
// use only these lockups as supplied by the designer.
interface Props {
  height?: number;
  variant?: 'horizontal' | 'stacked' | 'mark' | 'domain';
  class?: string;
}
const ratios: Record<string, number> = {
  horizontal: 1005.3 / 221,
  stacked: 732.9 / 450.7,
  mark: 224 / 221,
  domain: 1946.2 / 248.4,
};
const { height = 44, variant = 'horizontal', class: className } = Astro.props;
const width = Math.round(height * ratios[variant]);
---

<img
  src={`/brand/logo-${variant}.svg`}
  width={width}
  height={height}
  alt="Limitless PA"
  class={className}
  decoding="async"
/>
