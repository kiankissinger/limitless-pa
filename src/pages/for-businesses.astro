---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCopy, md, mdi } from '../lib/copy';

const t = await getCopy('for-businesses');
---

<Base
  title="For businesses"
  description="Get your Pennsylvania business listed with Limitless PA, and find simple, low-cost ways to welcome kids with sensory needs."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-cms="for-businesses:eyebrow">{t.eyebrow}</span>
      <h1 data-cms="for-businesses:title">{t.title}</h1>
      <p data-cms="for-businesses:intro">{t.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="why">
        <div class="stat card">
          <span class="num" data-cms="for-businesses:stat_number">{t.stat_number}</span>
          <p data-cms-mdi="for-businesses:stat_text" set:html={mdi(t.stat_text)} />
        </div>
        <div class="prose">
          <h2 data-cms="for-businesses:why_title">{t.why_title}</h2>
          <div data-cms-md="for-businesses:why_body" set:html={md(t.why_body)} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-cms="for-businesses:ideas_eyebrow">{t.ideas_eyebrow}</span>
        <h2 data-cms="for-businesses:ideas_title">{t.ideas_title}</h2>
        <p data-cms="for-businesses:ideas_intro">{t.ideas_intro}</p>
      </div>
      <ul class="ideas" data-cms-list="for-businesses:ideas">
        {
          (t.ideas ?? []).map((i: { icon: any; title: string; text: string }) => (
            <li class="card idea" data-cms-item>
              <span class="idea-icon">
                <Icon name={i.icon || 'check'} size={24} data-cms-field-icon="icon" />
              </span>
              <h3 data-cms-field="title">{i.title}</h3>
              <p data-cms-field="text">{i.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container steps-wrap">
      <div>
        <span class="eyebrow" data-cms="for-businesses:steps_eyebrow">{t.steps_eyebrow}</span>
        <h2 data-cms="for-businesses:steps_title">{t.steps_title}</h2>
        <ol class="steps" data-cms-list="for-businesses:steps">
          {
            (t.steps ?? []).map((step: { title: string; text: string }, n: number) => (
              <li data-cms-item>
                <span data-cms-field-index>{n + 1}</span>
                <div>
                  <strong data-cms-field="title">{step.title}</strong> <span data-cms-field="text">{step.text}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="card cta">
        <h2 data-cms="for-businesses:cta_title">{t.cta_title}</h2>
        <p data-cms="for-businesses:cta_text">{t.cta_text}</p>
        <a class="btn btn-primary" href="/suggest/?role=owner">List my business</a>
        <a class="btn btn-secondary" href="/submit-event/">Share an event</a>
        <p class="small" data-cms-mdi="for-businesses:cta_note" set:html={mdi(t.cta_note)} />
      </div>
    </div>
  </section>
</Base>

<style>
  .why {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .why {
      grid-template-columns: 360px 1fr;
      gap: 56px;
    }
  }
  .stat {
    padding: 28px;
    background: var(--brand-primary);
    color: #fff;
    border: 0;
  }
  .stat .num {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .stat a {
    color: #fff;
  }
  .stat p {
    margin: 0;
  }
  .prose h2 {
    color: var(--brand-primary);
    margin-top: 0;
  }
  .section-alt {
    background: var(--surface-alt);
  }
  .section-head h2 {
    color: var(--brand-primary);
  }
  .ideas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .idea {
    padding: 22px;
    box-shadow: none;
  }
  .idea-icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
    margin-bottom: 12px;
  }
  .idea h3 {
    color: var(--brand-primary);
    margin-bottom: 6px;
  }
  .idea p {
    margin: 0;
    color: var(--ink-muted);
  }
  .steps-wrap {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .steps-wrap {
      grid-template-columns: 1fr 360px;
      gap: 64px;
    }
  }
  .steps-wrap h2 {
    color: var(--brand-primary);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .steps li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .steps li > span {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brand-primary);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .cta {
    padding: 28px;
    display: grid;
    gap: 12px;
    background: var(--surface-alt);
    border: 0;
    box-shadow: none;
  }
  .cta h2,
  .cta p {
    margin: 0;
  }
  .small {
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
</style>
