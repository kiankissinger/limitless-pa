---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PlaceCard from '../components/PlaceCard.astro';
import EventCard from '../components/EventCard.astro';
import { categories } from '../data/taxonomy';
import { splitEvents } from '../lib/events';
import { getCopy, mdi } from '../lib/copy';

const t = await getCopy('home');
const places = (await getCollection('places'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const events = await getCollection('events');
const { upcoming, recurring } = splitEvents(events);

const featured = [...places.filter((p) => p.data.featured), ...places.filter((p) => !p.data.featured)].slice(0, 6);
const eventPreview = [...upcoming, ...recurring].slice(0, 4);
const countByCat = Object.fromEntries(categories.map((c) => [c.id, places.filter((p) => p.data.category === c.id).length]));
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" data-cms="home:hero.eyebrow">{t.hero.eyebrow}</span>
        <h1 data-cms="home:hero.title">{t.hero.title}</h1>
        <p class="lead" data-cms="home:hero.intro">{t.hero.intro}</p>

        <form class="hero-search" action="/places/" method="get" role="search">
          <label for="hero-q" class="visually-hidden">Search places</label>
          <Icon name="search" size={22} />
          <input id="hero-q" name="q" type="search" placeholder={t.hero.search_placeholder}
            data-cms-attr="placeholder|home:hero.search_placeholder"
          />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>

        <div class="hero-links">
          <a href="/places/">Browse all places <Icon name="arrow" size={16} /></a>
          <a href="/events/">See upcoming events <Icon name="arrow" size={16} /></a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-card main">
          <div class="art-head">
            <span class="art-icon"><Icon name="scissors" size={22} /></span>
            <div>
              <strong data-cms="home:example.title">{t.example.title}</strong>
              <span data-cms="home:example.category">{t.example.category}</span>
            </div>
          </div>
          <ul data-cms-list="home:example.items">
            {
              (t.example.items ?? []).map((item: string) => (
                <li data-cms-item>
                  <Icon name="check" size={18} /> <span data-cms-field=".">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- NOT MEDICAL STRIP -->
  <section class="strip">
    <div class="container strip-inner">
      <Icon name="shield" size={26} />
      <p>
        <strong data-cms="home:notice.title">{t.notice.title}</strong> <span data-cms="home:notice.text">{t.notice.text}</span>
      </p>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-cms="home:categories.eyebrow">{t.categories.eyebrow}</span>
        <h2 data-cms="home:categories.title">{t.categories.title}</h2>
      </div>
      <ul class="cat-grid">
        {
          categories.map((c) => (
            <li>
              <a href={`/places/?category=${c.id}`} class="cat-tile">
                <span class="cat-icon">
                  <Icon name={c.icon as any} size={24} />
                </span>
                <span class="cat-text">
                  <strong>{c.label}</strong>
                  <span>{countByCat[c.id] ? `${countByCat[c.id]} listed` : 'Help us add some'}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FEATURED PLACES -->
  {
    featured.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="head-row">
            <div class="section-head">
              <span class="eyebrow" data-cms="home:featured.eyebrow">{t.featured.eyebrow}</span>
              <h2 data-cms="home:featured.title">{t.featured.title}</h2>
            </div>
            <a class="btn btn-secondary" href="/places/">
              See all places
            </a>
          </div>
          <div class="grid grid-3">
            {featured.map((p) => (
              <PlaceCard place={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- WHAT WE LOOK FOR -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-cms="home:look_for.eyebrow">{t.look_for.eyebrow}</span>
        <h2 data-cms="home:look_for.title">{t.look_for.title}</h2>
        <p data-cms="home:look_for.intro">{t.look_for.intro}</p>
      </div>
      <ul class="look-grid" data-cms-list="home:look_for.items">
        {
          (t.look_for.items ?? []).map((l: { icon: any; title: string; text: string }) => (
            <li class="look card" data-cms-item>
              <span class="look-icon">
                <Icon name={l.icon || 'check'} size={24} data-cms-field-icon="icon" />
              </span>
              <h3 data-cms-field="title">{l.title}</h3>
              <p data-cms-field="text">{l.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section section-alt">
    <div class="container">
      <div class="head-row">
        <div class="section-head">
          <span class="eyebrow" data-cms="home:events.eyebrow">{t.events.eyebrow}</span>
          <h2 data-cms="home:events.title">{t.events.title}</h2>
        </div>
        <a class="btn btn-secondary" href="/events/">All events</a>
      </div>
      {
        eventPreview.length > 0 ? (
          <div class="grid grid-2">
            {eventPreview.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        ) : (
          <div class="empty card">
            <p data-cms-mdi="home:events.empty" set:html={mdi(t.events.empty)} />
          </div>
        )
      }
    </div>
  </section>

  <!-- CTAs -->
  <section class="section">
    <div class="container grid grid-2">
      <div class="cta card">
        <span class="cta-icon"><Icon name="heart" size={28} /></span>
        <h2 data-cms="home:cta_suggest.title">{t.cta_suggest.title}</h2>
        <p data-cms="home:cta_suggest.text">{t.cta_suggest.text}</p>
        <a class="btn btn-primary" href="/suggest/" data-cms="home:cta_suggest.button">{t.cta_suggest.button}</a>
      </div>
      <div class="cta card cta-green">
        <span class="cta-icon"><Icon name="store" size={28} /></span>
        <h2 data-cms="home:cta_business.title">{t.cta_business.title}</h2>
        <p data-cms="home:cta_business.text">{t.cta_business.text}</p>
        <a class="btn btn-secondary" href="/for-businesses/" data-cms="home:cta_business.button">{t.cta_business.button}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background: #fff;
    padding-block: clamp(40px, 7vw, 88px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .hero h1 {
    color: var(--brand-primary);
    max-width: 16ch;
  }
  .lead {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    color: var(--ink-muted);
    max-width: 54ch;
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 6px 6px 6px 18px;
    box-shadow: var(--shadow);
    max-width: 560px;
    margin-top: 28px;
  }
  .hero-search:focus-within {
    border-color: var(--brand-primary);
    outline: 2px solid var(--brand-primary);
  }
  .hero-search > :global(svg) {
    color: var(--ink-muted);
    flex-shrink: 0;
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.05rem;
    color: var(--ink);
    padding: 10px 0;
  }
  .hero-search input:focus {
    outline: none;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .hero-art {
    position: relative;
    max-width: 460px;
    width: 100%;
    margin-inline: auto;
  }
  .art-card {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lift);
    padding: 24px;
  }
  .art-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 16px;
  }
  .art-head strong {
    display: block;
    font-family: var(--font-display);
    color: var(--brand-primary);
    font-size: 1.08rem;
  }
  .art-head span {
    font-size: 0.9rem;
    color: var(--brand-primary);
    font-weight: 700;
  }
  .art-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--surface-alt);
    color: var(--brand-primary);
    flex-shrink: 0;
  }
  .art-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .art-card li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: var(--bg);
    border-radius: 10px;
  }
  .art-card li :global(svg) {
    color: var(--brand-green);
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .hero-art {
      display: none;
    }
  }

  /* Strip */
  .strip {
    background: var(--brand-primary);
    color: #fff;
  }
  .strip-inner {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-block: 22px;
  }
  .strip-inner :global(svg) {
    flex-shrink: 0;
    color: #fff;
  }
  .strip p {
    margin: 0;
  }
  .strip strong {
    color: #fff;
  }

  /* Categories */
  .cat-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
  }
  .cat-tile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cat-tile:hover {
    border-color: var(--brand-green);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .cat-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--surface-alt);
    color: var(--brand-primary);
    flex-shrink: 0;
  }
  .cat-text strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.25;
  }
  .cat-text span {
    font-size: 0.88rem;
    color: var(--ink-muted);
  }

  .section-alt {
    background: var(--surface-alt);
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 32px;
  }
  .head-row .section-head {
    margin-bottom: 0;
  }

  /* Look for */
  .look-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .look {
    padding: 22px;
    box-shadow: none;
  }
  .look-icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
    margin-bottom: 12px;
  }
  .look h3 {
    margin-bottom: 6px;
    color: var(--brand-primary);
  }
  .look p {
    margin: 0;
    color: var(--ink-muted);
  }

  .empty {
    padding: 28px;
    text-align: center;
  }
  .empty p {
    margin: 0;
  }

  /* CTAs */
  .cta {
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface-alt);
    border-color: transparent;
    box-shadow: none;
  }
  .cta-green {
    background: var(--surface-alt);
  }
  .cta-icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--surface);
    color: var(--brand-primary);
    margin-bottom: 16px;
  }
  .cta-green .cta-icon {
    color: var(--brand-primary);
  }
  .cta h2 {
    color: var(--brand-primary);
  }
  .cta p {
    max-width: 48ch;
  }
</style>
