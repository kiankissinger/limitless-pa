---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import PlaceDetail from '../../components/PlaceDetail.astro';
import { categoryById, type CategoryId } from '../../data/taxonomy';

export async function getStaticPaths() {
  const places = (await getCollection('places'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.name.localeCompare(b.data.name));
  return places.map((place) => ({ params: { slug: place.id }, props: { place, all: places } }));
}

const { place, all } = Astro.props;
const d = place.data;
const cat = categoryById[d.category as CategoryId];
const related = all.filter((p) => p.id !== place.id && p.data.category === d.category).slice(0, 3);
---

<Base title={d.name} description={d.summary}>
  <PlaceDetail data={d} body={place.body ?? ''} />

  {
    related.length > 0 && (
      <section class="section-tight related">
        <div class="container">
          <h2>More {cat.label.toLowerCase()}</h2>
          <div class="grid grid-3">
            {related.map((p) => (
              <PlaceCard place={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .related {
    background: var(--surface-alt);
  }
  .related h2 {
    color: var(--brand-primary);
  }
</style>
