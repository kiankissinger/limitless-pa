---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { accommodations, categoryById, type CategoryId } from '../../data/taxonomy';

export async function getStaticPaths() {
  const places = (await getCollection('places'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.name.localeCompare(b.data.name));
  return places.map((place) => ({ params: { slug: place.id }, props: { place, all: places } }));
}

const { place, all } = Astro.props;
const d = place.data;
const cat = categoryById[d.category as CategoryId];
const { Content } = await render(place);
const hasBody = Boolean(place.body?.trim());

const hints = Object.fromEntries(accommodations.map((a) => [a.id, a.hint])) as Record<string, string>;
const mapUrl = d.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${d.name}, ${d.address}`)}` : null;
const verified = d.verified?.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const related = all.filter((p) => p.id !== place.id && p.data.category === d.category).slice(0, 3);
const where = d.multiLocation ? 'Multiple locations across Pennsylvania' : [d.city, d.region].filter(Boolean).join(' · ');
---

<Base title={d.name} description={d.summary}>
  <section class="page-hero">
    <div class="container">
      <a class="back" href="/places/"><Icon name="back" size={18} /> All places</a>
      <div class="cat">
        <span class="cat-icon"><Icon name={cat.icon as any} size={20} /></span>
        {cat.label}
      </div>
      <h1>{d.name}</h1>
      <p class="where"><Icon name="pin" size={18} /> {where}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container detail">
      <div class="main">
        <p class="summary">{d.summary}</p>

        {
          d.accommodations.length > 0 && (
            <>
              <h2>Accommodations</h2>
              <ul class="acc-list">
                {d.accommodations.map((a) => (
                  <li>
                    <span class="check">
                      <Icon name="check" size={18} />
                    </span>
                    <div>
                      <strong>{a}</strong>
                      {hints[a] && <span>{hints[a]}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          hasBody && (
            <div class="prose notes">
              <h2>Good to know</h2>
              <Content />
            </div>
          )
        }

        <div class="notice">
          <Icon name="info" size={22} />
          <p>
            Programs and accommodations can change{d.multiLocation && ', and they can vary by location'}. Please call or check
            the website before you go. Something out of date? <a href={`/contact/?about=${encodeURIComponent(d.name)}`}
              >Let us know</a
            >.
          </p>
        </div>
      </div>

      <aside class="side card">
        <h2 class="visually-hidden">Details</h2>
        <dl>
          {
            d.schedule && (
              <div>
                <dt>
                  <Icon name="clock" size={18} /> When
                </dt>
                <dd>{d.schedule}</dd>
              </div>
            )
          }
          {
            d.address && (
              <div>
                <dt>
                  <Icon name="pin" size={18} /> Address
                </dt>
                <dd>
                  {d.address}
                  {mapUrl && (
                    <>
                      <br />
                      <a href={mapUrl} target="_blank" rel="noopener">
                        Open in Maps
                      </a>
                    </>
                  )}
                </dd>
              </div>
            )
          }
          {
            d.ages && (
              <div>
                <dt>
                  <Icon name="child" size={18} /> Ages
                </dt>
                <dd>{d.ages}</dd>
              </div>
            )
          }
          {
            d.cost && (
              <div>
                <dt>
                  <Icon name="dollar" size={18} /> Cost
                </dt>
                <dd>{d.cost}</dd>
              </div>
            )
          }
          {
            d.phone && (
              <div>
                <dt>
                  <Icon name="phone" size={18} /> Phone
                </dt>
                <dd>
                  <a href={`tel:${d.phone.replace(/[^\d+]/g, '')}`}>{d.phone}</a>
                </dd>
              </div>
            )
          }
        </dl>
        {
          d.website && (
            <a class="btn btn-primary site-btn" href={d.website} target="_blank" rel="noopener">
              Visit website <Icon name="external" size={18} />
            </a>
          )
        }
        {
          (verified || d.source) && (
            <p class="verified">
              {verified && <>Details checked {verified}. </>}
              {d.source && (
                <a href={d.source} target="_blank" rel="noopener">
                  Source
                </a>
              )}
            </p>
          )
        }
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight related">
        <div class="container">
          <h2>More {cat.label.toLowerCase()}</h2>
          <div class="grid grid-3">
            {related.map((p) => (
              <PlaceCard place={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--brand-primary);
    margin-bottom: 8px;
  }
  .cat-icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fff;
    color: var(--brand-primary);
  }
  h1 {
    color: var(--brand-primary);
  }
  .where {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .detail {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .detail {
      grid-template-columns: 1fr 340px;
      gap: 48px;
    }
    .side {
      position: sticky;
      top: 96px;
    }
  }
  .summary {
    font-size: 1.2rem;
  }
  .main h2 {
    font-size: 1.35rem;
    color: var(--brand-primary);
    margin-top: 1.4em;
  }
  .acc-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .acc-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .acc-list li {
    display: flex;
    gap: 12px;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .acc-list strong {
    display: block;
  }
  .acc-list span:not(.check) {
    font-size: 0.92rem;
    color: var(--ink-muted);
  }
  .check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
  }
  .notes {
    margin-bottom: 24px;
  }
  .notice {
    margin-top: 24px;
  }
  .side {
    padding: 24px;
  }
  dl {
    margin: 0 0 20px;
    display: grid;
    gap: 16px;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--brand-primary);
  }
  dt :global(svg) {
    color: var(--brand-green);
  }
  dd {
    margin: 4px 0 0 26px;
  }
  .site-btn {
    width: 100%;
  }
  .verified {
    margin: 14px 0 0;
    font-size: 0.88rem;
    color: var(--ink-muted);
  }
  .related {
    background: var(--surface-alt);
  }
  .related h2 {
    color: var(--brand-primary);
  }
</style>
