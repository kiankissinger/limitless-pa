---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCopy, md } from '../lib/copy';

const t = (await getCopy('forms')).contact;
---

<Base title="Contact us" description="Get in touch with Limitless PA.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-cms="forms:contact.eyebrow">{t.eyebrow}</span>
      <h1 data-cms="forms:contact.title">{t.title}</h1>
      <p data-cms="forms:contact.intro">{t.intro}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container form-wrap">
      <form
        class="form card form-card"
        name="contact"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="subject" value="New message — Limitless PA" />
        <p class="honeypot"><label>Don’t fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <div class="field">
            <label for="name">Your name <span class="req">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Your email <span class="req">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="topic">What’s this about?</label>
          <select id="topic" name="topic">
            <option>General question</option>
            <option>Update or correction to a listing</option>
            <option>I want to volunteer</option>
            <option>Partnership or sponsorship</option>
            <option>Donating</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="about">Listing or event (if any)</label>
          <input id="about" name="about" type="text" />
        </div>

        <div class="field">
          <label for="message">Message <span class="req">*</span></label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <button class="btn btn-primary submit" type="submit">Send message</button>
      </form>

      <aside class="aside">
        <div class="card tip">
          <Icon name="shield" size={22} />
          <div>
            <h2 data-cms="forms:contact.note_title">{t.note_title}</h2>
            <div data-cms-md="forms:contact.note_body" set:html={md(t.note_body)} />
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  // Prefill the topic from ?topic= (used by the Donate page)
  const topics: Record<string, string> = { donate: 'Donating', volunteer: 'I want to volunteer' };
  const t = topics[params.get('topic') ?? ''];
  const topicSelect = document.getElementById('topic') as HTMLSelectElement | null;
  if (t && topicSelect) topicSelect.value = t;

  // Prefill "about" from ?about= (used by "Let us know" links on listings)
  const about = params.get('about');
  if (about) {
    const input = document.getElementById('about') as HTMLInputElement | null;
    const topic = document.getElementById('topic') as HTMLSelectElement | null;
    if (input) input.value = about;
    if (topic) topic.value = 'Update or correction to a listing';
  }
</script>
