---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Contact us" description="Get in touch with Limitless PA.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Say hello</h1>
      <p>Questions, corrections, partnership ideas, or just want to help? We’d love to hear from you.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container form-wrap">
      <form
        class="form card form-card"
        name="contact"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="subject" value="New message — Limitless PA" />
        <p class="honeypot"><label>Don’t fill this out: <input name="bot-field" /></label></p>

        <div class="form-row">
          <div class="field">
            <label for="name">Your name <span class="req">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Your email <span class="req">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="field">
          <label for="topic">What’s this about?</label>
          <select id="topic" name="topic">
            <option>General question</option>
            <option>Update or correction to a listing</option>
            <option>I want to volunteer</option>
            <option>Partnership or sponsorship</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="about">Listing or event (if any)</label>
          <input id="about" name="about" type="text" />
        </div>

        <div class="field">
          <label for="message">Message <span class="req">*</span></label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <button class="btn btn-primary submit" type="submit">Send message</button>
      </form>

      <aside class="aside">
        <div class="card tip">
          <Icon name="shield" size={22} />
          <div>
            <h2>Please note</h2>
            <p>
              We’re a community resource, not medical providers, and we can’t give medical, therapy, or legal advice. In an
              emergency call <a href="tel:911">911</a>; for crisis support call or text <a href="tel:988">988</a>.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Prefill "about" from ?about= (used by "Let us know" links on listings)
  const about = new URLSearchParams(location.search).get('about');
  if (about) {
    const input = document.getElementById('about') as HTMLInputElement | null;
    const topic = document.getElementById('topic') as HTMLSelectElement | null;
    if (input) input.value = about;
    if (topic) topic.value = 'Update or correction to a listing';
  }
</script>
