---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { getCopy, md } from '../lib/copy';

const t = await getCopy('about');
---

<Base title="About us" description="Limitless PA connects Pennsylvania families of kids with special needs to welcoming places, events, and community.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="prose">
        <h2>{t.why_title}</h2>
        <Fragment set:html={md(t.why_body)} />

        <h2>{t.do_title}</h2>
        <ul class="do-list">
          {
            (t.do_items ?? []).map((i: { icon: any; title: string; text: string }) => (
              <li>
                <Icon name={i.icon || 'check'} size={22} />
                <span>
                  <strong>{i.title}</strong> {i.text}
                </span>
              </li>
            ))
          }
        </ul>

        <h2>{t.not_title}</h2>
        <Fragment set:html={md(t.not_body)} />

        <h2>{t.how_title}</h2>
        <Fragment set:html={md(t.how_body)} />
      </div>

      <aside class="side">
        <div class="card logo-card">
          <Logo variant="stacked" height={150} />
        </div>
        <div class="card help">
          <h2>{t.help_title}</h2>
          <ul>
            <li><a href="/suggest/">Suggest a place</a></li>
            <li><a href="/submit-event/">Share an event</a></li>
            <li><a href="/for-businesses/">Tell a business about us</a></li>
            <li><a href="/contact/">Volunteer or partner with us</a></li>
            <li><a href="/donate/">Donate</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 320px;
      gap: 64px;
    }
  }
  .prose h2 {
    color: var(--brand-primary);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .do-list {
    list-style: none;
    padding: 0 !important;
    display: grid;
    gap: 14px;
  }
  .do-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .do-list :global(svg) {
    flex-shrink: 0;
    color: var(--brand-green);
    margin-top: 3px;
  }
  .side {
    display: grid;
    gap: 16px;
  }
  .logo-card {
    display: grid;
    place-items: center;
    padding: 32px 24px;
    box-shadow: none;
  }
  .logo-card :global(img) {
    width: 100%;
    max-width: 240px;
    height: auto;
  }
  .help {
    padding: 24px;
    background: var(--surface-alt);
    border: 0;
    box-shadow: none;
  }
  .help h2 {
    font-size: 1.1rem;
    color: var(--brand-primary);
  }
  .help ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
</style>
