---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCopy, mdi } from '../lib/copy';

const t = await getCopy('resources');
---

<Base
  title="Resources for families"
  description="Practical tips for planning sensory-friendly outings, questions to ask businesses, and helpful Pennsylvania organizations."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-cms="resources:eyebrow">{t.eyebrow}</span>
      <h1 data-cms="resources:title">{t.title}</h1>
      <p data-cms="resources:intro">{t.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 data-cms="resources:tips_title">{t.tips_title}</h2>
        <p data-cms="resources:tips_intro">{t.tips_intro}</p>
      </div>
      <ul class="tips" data-cms-list="resources:tips">
        {
          (t.tips ?? []).map((tip: { icon: any; title: string; text: string }) => (
            <li class="card tip-card" data-cms-item>
              <span class="tip-icon">
                <Icon name={tip.icon || 'check'} size={22} data-cms-field-icon="icon" />
              </span>
              <div>
                <h3 data-cms-field="title">{tip.title}</h3>
                <p data-cms-field="text">{tip.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="eyebrow" data-cms="resources:questions_eyebrow">{t.questions_eyebrow}</span>
        <h2 data-cms="resources:questions_title">{t.questions_title}</h2>
        <p class="muted" data-cms="resources:questions_intro">{t.questions_intro}</p>
      </div>
      <ul class="questions card" data-cms-list="resources:questions">
        {
          (t.questions ?? []).map((q: string) => (
            <li data-cms-item>
              <Icon name="message" size={20} />
              <span data-cms-field=".">{q}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-cms="resources:orgs_eyebrow">{t.orgs_eyebrow}</span>
        <h2 data-cms="resources:orgs_title">{t.orgs_title}</h2>
        <p data-cms="resources:orgs_intro">{t.orgs_intro}</p>
      </div>
      <ul class="orgs grid grid-2" data-cms-list="resources:orgs">
        {
          (t.orgs ?? []).map((o: { name: string; url: string; text: string }) => (
            <li class="card org" data-cms-item>
              <h3 data-cms-field="name">{o.name}</h3>
              <p data-cms-field="text">{o.text}</p>
              <a href={o.url} target="_blank" rel="noopener" data-cms-field-href="url" hidden={!o.url}>
                Visit website <Icon name="external" size={16} />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="notice note">
        <Icon name="shield" size={22} />
        <p data-cms-mdi="resources:note" set:html={mdi(t.note)} />
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head h2,
  .two-col h2 {
    color: var(--brand-primary);
  }
  .tips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .tip-card {
    display: flex;
    gap: 14px;
    padding: 20px;
    box-shadow: none;
  }
  .tip-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
  }
  .tip-card h3 {
    margin-bottom: 4px;
    color: var(--brand-primary);
  }
  .tip-card p {
    margin: 0;
    color: var(--ink-muted);
  }
  .section-alt {
    background: var(--surface-alt);
  }
  .two-col {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
  }
  .muted {
    color: var(--ink-muted);
  }
  .questions {
    list-style: none;
    margin: 0;
    padding: 8px 20px;
    box-shadow: none;
  }
  .questions li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .questions li:last-child {
    border-bottom: 0;
  }
  .questions :global(svg) {
    flex-shrink: 0;
    color: var(--brand-green);
    margin-top: 3px;
  }
  .orgs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .org {
    padding: 22px;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }
  .org h3 {
    color: var(--brand-primary);
    margin-bottom: 6px;
  }
  .org a {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
  }
  .note {
    margin-top: 28px;
  }
</style>
