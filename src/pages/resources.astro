---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCopy, mdi } from '../lib/copy';

const t = await getCopy('resources');
---

<Base
  title="Resources for families"
  description="Practical tips for planning sensory-friendly outings, questions to ask businesses, and helpful Pennsylvania organizations."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t.tips_title}</h2>
        <p>{t.tips_intro}</p>
      </div>
      <ul class="tips">
        {
          (t.tips ?? []).map((tip: { icon: any; title: string; text: string }) => (
            <li class="card tip-card">
              <span class="tip-icon">
                <Icon name={tip.icon || 'check'} size={22} />
              </span>
              <div>
                <h3>{tip.title}</h3>
                <p>{tip.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="eyebrow">{t.questions_eyebrow}</span>
        <h2>{t.questions_title}</h2>
        <p class="muted">{t.questions_intro}</p>
      </div>
      <ul class="questions card">
        {
          (t.questions ?? []).map((q: string) => (
            <li>
              <Icon name="message" size={20} />
              <span>{q}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.orgs_eyebrow}</span>
        <h2>{t.orgs_title}</h2>
        <p>{t.orgs_intro}</p>
      </div>
      <ul class="orgs grid grid-2">
        {
          (t.orgs ?? []).map((o: { name: string; url: string; text: string }) => (
            <li class="card org">
              <h3>{o.name}</h3>
              <p>{o.text}</p>
              {o.url && (
                <a href={o.url} target="_blank" rel="noopener">
                  Visit website <Icon name="external" size={16} />
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="notice note">
        <Icon name="shield" size={22} />
        <p set:html={mdi(t.note)} />
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head h2,
  .two-col h2 {
    color: var(--brand-primary);
  }
  .tips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .tip-card {
    display: flex;
    gap: 14px;
    padding: 20px;
    box-shadow: none;
  }
  .tip-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
  }
  .tip-card h3 {
    margin-bottom: 4px;
    color: var(--brand-primary);
  }
  .tip-card p {
    margin: 0;
    color: var(--ink-muted);
  }
  .section-alt {
    background: var(--surface-alt);
  }
  .two-col {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
  }
  .muted {
    color: var(--ink-muted);
  }
  .questions {
    list-style: none;
    margin: 0;
    padding: 8px 20px;
    box-shadow: none;
  }
  .questions li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .questions li:last-child {
    border-bottom: 0;
  }
  .questions :global(svg) {
    flex-shrink: 0;
    color: var(--brand-green);
    margin-top: 3px;
  }
  .orgs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .org {
    padding: 22px;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }
  .org h3 {
    color: var(--brand-primary);
    margin-bottom: 6px;
  }
  .org a {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
  }
  .note {
    margin-top: 28px;
  }
</style>
