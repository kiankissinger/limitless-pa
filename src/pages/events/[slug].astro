---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventDetail from '../../components/EventDetail.astro';

export async function getStaticPaths() {
  const events = (await getCollection('events')).filter((e) => !e.data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
---

<Base title={event.data.title} description={event.data.summary}>
  <EventDetail data={event.data} id={event.id} body={event.body ?? ''} />
</Base>
