---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCopy, md, mdi } from '../lib/copy';

const t = await getCopy('donate');
const link = (t.donation_link ?? '').trim();
---

<Base title="Donate" description="Support Limitless PA and how you can help families across Pennsylvania." noindex={!link}>
  <section class="section">
    <div class="container soon">
      <span class="badge"><Icon name="heart" size={30} /></span>
      <h1 data-cms="donate:title">{t.title}</h1>
      <p class="lead" data-cms="donate:lead">{t.lead}</p>
      <a
        class="btn btn-primary give"
        href={link}
        target="_blank"
        rel="noopener"
        data-cms-show="donate:donation_link"
        data-cms-attr="href|donate:donation_link"
        hidden={!link}
      >
        <span data-cms="donate:donation_button">{t.donation_button || 'Donate'}</span>
      </a>

      <div class="card meantime">
        <h2 data-cms="donate:ways_title">{t.ways_title}</h2>
        <div data-cms-md="donate:ways" set:html={md(t.ways)} />
      </div>

      <p class="notify" data-cms-mdi="donate:notify" data-cms-hide="donate:donation_link" hidden={!t.notify || !!link} set:html={mdi(t.notify)} />
    </div>
  </section>
</Base>

<style>
  .soon {
    max-width: 640px;
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--brand-primary);
    margin-bottom: 20px;
  }
  h1 {
    color: var(--brand-primary);
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .meantime {
    width: 100%;
    text-align: left;
    padding: 24px 28px;
    margin-top: 12px;
    box-shadow: none;
  }
  .meantime h2 {
    font-size: 1.1rem;
    color: var(--brand-primary);
    margin-bottom: 12px;
  }
  .meantime ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .give {
    margin: 4px 0 12px;
    min-width: 180px;
  }
  .meantime :global(ul) {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
  .notify {
    margin-top: 24px;
    font-size: 0.97rem;
    color: var(--ink-muted);
  }
</style>
